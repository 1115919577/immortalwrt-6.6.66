#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-3.0-only
# luci-app-turboacc init script (firewall4 / nftables)

START=90
STOP=10

EXTRA_COMMANDS="check_status check_applied"
EXTRA_HELP="	check_status Check running status of utils
	check_applied Show whether turboacc settings have been applied"

restart_utils="true"

KMOD_DIR="/lib/modules/$(uname -r)"

has_kmod() {
	local module="$1"
	[ -d "/sys/module/${module}" ] || ls "${KMOD_DIR}/${module}.ko"* >/dev/null 2>&1
}

normalize_config() {
	uci -q get turboacc.config >/dev/null 2>&1 && return 0
	uci -q rename turboacc.@turboacc[0]=config 2>/dev/null || uci -q set turboacc.config=turboacc
	uci -q commit turboacc
}

initial_conf() {
	normalize_config
	sw_flow="$(uci -q get turboacc.config.sw_flow)"
	hw_flow="$(uci -q get turboacc.config.hw_flow)"
	hw_wed="$(uci -q get turboacc.config.hw_wed)"
	bbr_cca="$(uci -q get turboacc.config.bbr_cca)"
	fullcone_nat="$(uci -q get turboacc.config.fullcone_nat)"
	fullcone6="$(uci -q get turboacc.config.fullcone6)"

	# Sanitize values: only "1" enables, anything else (including empty) disables.
	[ "${sw_flow}"      = "1" ] || sw_flow="0"
	[ "${hw_flow}"      = "1" ] || hw_flow="0"
	[ "${hw_wed}"       = "1" ] || hw_wed="0"
	[ "${bbr_cca}"      = "1" ] || bbr_cca="0"
	[ "${fullcone_nat}" = "1" ] || fullcone_nat="0"
	[ "${fullcone6}"    = "1" ] || fullcone6="0"

	logger -t turboacc "read config: sw_flow=${sw_flow}, hw_flow=${hw_flow}, hw_wed=${hw_wed}, fullcone=${fullcone_nat}, fullcone6=${fullcone6}, bbr=${bbr_cca}"

	# firewall4 hard constraint: HW offloading requires SW offloading to be enabled.
	[ "${sw_flow}" = "0" ] && hw_flow="0"

	# WED depends on HW offloading.
	[ "${hw_flow}" = "0" ] && hw_wed="0"

	# IPv6 FullCone depends on FullCone NAT.
	[ "${fullcone_nat}" = "0" ] && fullcone6="0"

}

load_wed() {
	grep -Eq 'mediatek' /etc/openwrt_release || return 0
	has_kmod "mt7915e" || return 0

	[ -f /etc/modules.conf ] || touch /etc/modules.conf
	if ! grep -Eq '^options[[:space:]]+mt7915e[[:space:]]+wed_enable=Y' /etc/modules.conf; then
		# Drop any stale mt7915e options first to avoid duplicates.
		sed -i '/^options[[:space:]]\+mt7915e/d' /etc/modules.conf
		echo "options mt7915e wed_enable=Y" >> /etc/modules.conf
		rmmod mt7915e 2>/dev/null
		sleep 1
		modprobe mt7915e
		wifi up
	fi
}

unload_wed() {
	grep -Eq 'mediatek' /etc/openwrt_release || return 0
	has_kmod "mt7915e" || return 0

	if grep -Eq '^options[[:space:]]+mt7915e' /etc/modules.conf 2>/dev/null; then
		sed -i '/^options[[:space:]]\+mt7915e/d' /etc/modules.conf
		rmmod mt7915e 2>/dev/null
		sleep 1
		modprobe mt7915e
		wifi up
	fi
}

apply_firewall_uci() {
	# Write settings into firewall4 defaults (nftables).
	uci -q set firewall.@defaults[0].flow_offloading="${sw_flow}"
	uci -q set firewall.@defaults[0].flow_offloading_hw="${hw_flow}"
	uci -q set firewall.@defaults[0].fullcone="${fullcone_nat}"
	uci -q set firewall.@defaults[0].fullcone6="${fullcone6}"
	logger -t turboacc "write firewall: flow_offloading=${sw_flow}, flow_offloading_hw=${hw_flow}, fullcone=${fullcone_nat}, fullcone6=${fullcone6}, bbr=${bbr_cca}"

	# Per-zone IPv6 FullCone toggle (only zones that already declare the option).
	for i in $(uci -q show firewall | sed -n 's/^\(firewall\.@zone\[[0-9]\+\]\.fullcone6\)=.*/\1/p'); do
		uci -q set "${i}=${fullcone6}"
	done

	uci -q commit firewall
}

apply_bbr() {
	if [ "${bbr_cca}" = "1" ]; then
		modprobe tcp_bbr 2>/dev/null
		if grep -qw bbr /proc/sys/net/ipv4/tcp_available_congestion_control 2>/dev/null; then
			if sysctl -wq net.ipv4.tcp_congestion_control=bbr 2>/dev/null; then
				logger -t turboacc "write bbr: tcp_congestion_control=bbr"
			else
				logger -t turboacc "write bbr failed: sysctl rejected bbr"
			fi
		else
			logger -t turboacc "write bbr skipped: tcp_bbr is not available"
		fi
	else
		if grep -qw cubic /proc/sys/net/ipv4/tcp_available_congestion_control 2>/dev/null; then
			if sysctl -wq net.ipv4.tcp_congestion_control=cubic 2>/dev/null; then
				logger -t turboacc "write bbr: tcp_congestion_control=cubic"
			else
				logger -t turboacc "write bbr failed: sysctl rejected cubic"
			fi
		else
			logger -t turboacc "write bbr skipped: cubic is not available"
		fi
	fi
}

restart_services() {
	[ "${restart_utils}" = "true" ] || return 0
	/etc/init.d/dnsmasq  restart >/dev/null 2>&1
	/etc/init.d/firewall restart >/dev/null 2>&1
}

start() {
	logger -t turboacc "start: applying firewall4 offloading settings"
	initial_conf
	apply_firewall_uci

	if [ "${hw_flow}" = "1" ] && [ "${hw_wed}" = "1" ]; then
		load_wed
	fi

	apply_bbr
	restart_services
}

boot() {
	start
}

stop() {
	logger -t turboacc "stop: applying current disabled/enabled settings"
	# When stopping the service we still write the user's current preference
	# into firewall (so disabling the toggle takes effect) and unload WED if
	# the user disabled it.
	initial_conf
	apply_firewall_uci

	if [ "${hw_wed}" = "0" ]; then
		unload_wed
	fi

	restart_services
}

restart() {
	logger -t turboacc "restart: reloading acceleration settings"
	initial_conf
	apply_firewall_uci

	if [ "${hw_flow}" = "1" ] && [ "${hw_wed}" = "1" ]; then
		load_wed
	else
		unload_wed
	fi

	apply_bbr
	/etc/init.d/dnsmasq  restart >/dev/null 2>&1
	/etc/init.d/firewall restart >/dev/null 2>&1
}

reload() {
	# "Save & Apply" in LuCI maps to reload via ucitrack.
	restart
}

check_applied() {
	initial_conf
	current_bbr="$(cat /proc/sys/net/ipv4/tcp_congestion_control 2>/dev/null)"

	[ "$(uci -q get firewall.@defaults[0].flow_offloading)" = "${sw_flow}" ] || {
		printf '%s\n' "turboacc settings are not applied"
		return 1
	}

	[ "$(uci -q get firewall.@defaults[0].flow_offloading_hw)" = "${hw_flow}" ] || {
		printf '%s\n' "turboacc settings are not applied"
		return 1
	}

	[ "$(uci -q get firewall.@defaults[0].fullcone)" = "${fullcone_nat}" ] || {
		printf '%s\n' "turboacc settings are not applied"
		return 1
	}

	[ "$(uci -q get firewall.@defaults[0].fullcone6)" = "${fullcone6}" ] || {
		printf '%s\n' "turboacc settings are not applied"
		return 1
	}

	if [ "${bbr_cca}" = "1" ] && [ "${current_bbr}" != "bbr" ]; then
		printf '%s\n' "turboacc settings are not applied"
		return 1
	fi

	if [ "${bbr_cca}" = "0" ] && [ "${current_bbr}" = "bbr" ]; then
		printf '%s\n' "turboacc settings are not applied"
		return 1
	fi

	printf '%s\n' "turboacc settings are applied"
	return 0
}

check_status() {
	local target="$1"
	local emit_msg="${2:-1}"

	case "${target}" in
		fastpath)
			if [ "$(uci -q get firewall.@defaults[0].flow_offloading_hw)" = "1" ]; then
				msg="Hardware Flow Offloading"
				exit_code=0
			elif [ "$(uci -q get firewall.@defaults[0].flow_offloading)" = "1" ]; then
				msg="Software Flow Offloading"
				exit_code=0
			else
				msg=""
				exit_code=1
			fi
			;;
		sw_flow)
			if [ "$(uci -q get firewall.@defaults[0].flow_offloading)" = "1" ]; then
				exit_code=0
			else
				exit_code=1
			fi
			;;
		hw_flow)
			if [ "$(uci -q get firewall.@defaults[0].flow_offloading_hw)" = "1" ]; then
				exit_code=0
			else
				exit_code=1
			fi
			;;
		fullconenat)
			if [ "$(uci -q get firewall.@defaults[0].fullcone)" = "1" ]; then
				exit_code=0
			else
				exit_code=1
			fi
			;;
		bbr)
			if [ "$(cat /proc/sys/net/ipv4/tcp_congestion_control 2>/dev/null)" = "bbr" ]; then
				exit_code=0
			else
				exit_code=1
			fi
			;;
		*)
			exit 2
			;;
	esac

	if [ -n "${msg}" ] && [ "${emit_msg}" = "1" ]; then
		printf '%s' "${msg}"
	fi
	exit "${exit_code}"
}
