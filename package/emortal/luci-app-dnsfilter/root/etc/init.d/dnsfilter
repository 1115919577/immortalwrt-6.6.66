#!/bin/sh /etc/rc.common
START=99
STOP=10
B=0
CRON_FILE=/etc/crontabs/root
E="date +'%Y-%m-%d %H:%M:%S'"
L=/etc/dnsfilter
P=/usr/share/dnsfilter
T=/tmp/dnsfilter
STATUS=Y
DNSMASQ_CONF_DIR="/tmp/dnsmasq.d"
DEFAULT_DNSMASQ_CFGID="$(uci -q show "dhcp.@dnsmasq[0]" | awk 'NR==1 {split($0, conf, /[.=]/); print conf[2]}')"
if [ -f "/tmp/etc/dnsmasq.conf.$DEFAULT_DNSMASQ_CFGID" ]; then
	DNSMASQ_CONF_DIR="$(awk -F '=' '/^conf-dir=/ {print $2}' "/tmp/etc/dnsmasq.conf.$DEFAULT_DNSMASQ_CFGID" | tail -n 1)"
	if [ -n "$DNSMASQ_CONF_DIR" ]; then
		DNSMASQ_CONF_DIR="${DNSMASQ_CONF_DIR%%,*}"
		DNSMASQ_CONF_DIR=${DNSMASQ_CONF_DIR%*/}
	else
		DNSMASQ_CONF_DIR="/tmp/dnsmasq.d"
	fi
fi
DNSFILTER_RULE_CONF="$DNSMASQ_CONF_DIR/dnsfilter.rules.conf"
DNSFILTER_BLACK_CONF="$DNSMASQ_CONF_DIR/dnsfilter.black.conf"
enable=$(uci -q get dnsfilter.@dnsfilter[0].enable)
flash=$(uci -q get dnsfilter.@dnsfilter[0].flash)
url=$(uci -q get dnsfilter.@dnsfilter[0].url)

ensure_dns_dir(){
	mkdir -p "$DNSMASQ_CONF_DIR"
}

clean_dns_dir(){
	ensure_dns_dir
	rm -f "$DNSFILTER_RULE_CONF" "$DNSFILTER_BLACK_CONF" \
		"$DNSMASQ_CONF_DIR/dnsfilter.conf" \
		/tmp/dnsmasq.d/dnsfilter.conf /var/dnsmasq.d/dnsfilter.conf \
		/tmp/dnsmasq.d/dnsfilter.rules.conf /var/dnsmasq.d/dnsfilter.rules.conf \
		/tmp/dnsmasq.d/dnsfilter.black.conf /var/dnsmasq.d/dnsfilter.black.conf
	rm -rf "$DNSMASQ_CONF_DIR/dnsmasq.dnsfilter" \
		/tmp/dnsmasq.d/dnsmasq.dnsfilter /var/dnsmasq.d/dnsmasq.dnsfilter
}

remove_dnsmasq_conf(){
	clean_dns_dir
	for f in /tmp/etc/dnsmasq.conf.*; do
		[ -f "$f" ] || continue
		dir="$(awk -F '=' '/^conf-dir=/ {print $2}' "$f" | tail -n 1)"
		[ -n "$dir" ] || continue
		dir="${dir%%,*}"
		dir="${dir%*/}"
		rm -f "$dir/dnsfilter.conf" "$dir/dnsfilter.rules.conf" "$dir/dnsfilter.black.conf"
		rm -rf "$dir/dnsmasq.dnsfilter"
	done
}

get_config(){
	config_get_bool cron_mode $1 cron_mode 1
	config_get update_day $1 update_day '*'
	config_get time_update $1 time_update 6
}

clean_cron(){
	[ -f "$CRON_FILE" ] || return 0
	grep -Fv "$P/dnsfilter" "$CRON_FILE" | grep -Fv "$P/addown --down" > "$CRON_FILE.tmp"
	mv -f "$CRON_FILE.tmp" "$CRON_FILE"
}

install_dns_rule_conf(){
	src="$1"
	dst="$2"
	mode="$3"
	[ -s "$src" ] || {
		rm -f "$dst"
		return 1
	}

	rm -f "$dst"
	# dnsmasq 目录里必须是真实文件，不能是软链接，避免启动时遇到断链直接失败。
	# 非 flash 模式使用 mv，把规则文件移动到 dnsmasq conf-dir；
	# 然后尽量硬链接回 /tmp/dnsfilter/rules.conf，供 LuCI 显示和刷新比较使用，不额外占空间。
	if [ "$mode" = "move" ]; then
		mv -f "$src" "$dst" || return 1
		ln "$dst" "$src" 2>/dev/null
	else
		cp -f "$src" "$dst"
	fi
}

add_dns(){
	ensure_dns_dir
	clean_dns_dir
	if [ -n "$url" ];then
		mkdir -p "$T"
		if [ "$flash" = "1" ];then
			ln -sf "$L/rules/rules.conf" "$T/rules.conf"
			ln -sf "$L/rules/url" "$T/url"
			install_dns_rule_conf "$L/rules/rules.conf" "$DNSFILTER_RULE_CONF" "copy"
		else
			install_dns_rule_conf "$T/rules.conf" "$DNSFILTER_RULE_CONF" "move"
		fi
	fi
	[ -s "$L/black.list" ] && cat "$L/black.list" >> "$DNSFILTER_BLACK_CONF"
	if [ -s "$DNSFILTER_BLACK_CONF" ];then
		sed -i -e 's:^:address=/:' -e 's:$:/:' "$DNSFILTER_BLACK_CONF"
		sort -u "$DNSFILTER_BLACK_CONF" -o "$DNSFILTER_BLACK_CONF"
		for i in $(cat "$DNSFILTER_BLACK_CONF");do
			if grep -wq "$i" "$DNSFILTER_RULE_CONF" 2>/dev/null;then
				sed -i -e "s#$i##" -e '/^$/d' "$DNSFILTER_BLACK_CONF"
			fi
		done
		for i in $(cat "$L/white.list");do sed -i -e "/\/$i\//d" -e "/\.$i\//d" "$DNSFILTER_BLACK_CONF";done
	else
		rm -f "$DNSFILTER_BLACK_CONF"
	fi

}

add_rule(){
	command -v nft >/dev/null 2>&1 || {
		echo "`eval $E` [nftables is not available]"
		return 1
	}
	nft delete table inet dnsfilter 2>/dev/null
	nft -f - <<-EOF || return 1
	table inet dnsfilter {
		set blockip4 {
			type ipv4_addr
			flags interval
		}

		set blockip6 {
			type ipv6_addr
			flags interval
		}

		chain forward {
			type filter hook forward priority -1; policy accept;
			ip daddr @blockip4 counter drop
			ip6 daddr @blockip6 counter drop
		}

		chain output {
			type filter hook output priority -1; policy accept;
			ip daddr @blockip4 counter drop
			ip6 daddr @blockip6 counter drop
		}
	}
EOF
	[ -s "$L/ip.list" ] || return 0
	while read -r ip; do
		ip="${ip%%#*}"
		ip="$(echo "$ip" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
		[ -z "$ip" ] && continue
		case "$ip" in
			*:*) nft add element inet dnsfilter blockip6 "{ $ip }" 2>/dev/null ;;
			*) nft add element inet dnsfilter blockip4 "{ $ip }" 2>/dev/null ;;
		esac
	done < "$L/ip.list"
}

add_cron(){
	local cron_day cron_line
	[ -f "$CRON_FILE" ] || touch "$CRON_FILE"
	case "$time_update" in
		''|*[!0-9]*) time_update=6 ;;
		*) [ "$time_update" -ge 0 ] 2>/dev/null && [ "$time_update" -le 23 ] 2>/dev/null || time_update=6 ;;
	esac
	case "$update_day" in
		'*'|0|1|2|3|4|5|6) cron_day="$update_day" ;;
		*) cron_day='*' ;;
	esac
	cron_line="0 $time_update * * $cron_day $P/addown --down 1"
	if [ "$cron_mode" = "1" ];then
		if ! grep -Fxq "$cron_line" "$CRON_FILE";then
			clean_cron
			echo "$cron_line" >> "$CRON_FILE"
			/etc/init.d/cron restart
		fi
	else
		del_cron
	fi
}

del_cron(){
	if [ -f "$CRON_FILE" ] && { grep -q "$P/dnsfilter" "$CRON_FILE" || grep -q "$P/addown --down" "$CRON_FILE"; }; then
		clean_cron
		/etc/init.d/cron restart
	fi
}

del_rule(){
	nft delete table inet dnsfilter 2>/dev/null
}

start(){
	B=0
	enable=$(uci -q get dnsfilter.@dnsfilter[0].enable)
	flash=$(uci -q get dnsfilter.@dnsfilter[0].flash)
	url=$(uci -q get dnsfilter.@dnsfilter[0].url)
	config_load dnsfilter
	config_foreach get_config dnsfilter
	if [ "$enable" != "1" ];then
		echo "`eval $E` [DNSFilter is disabled]"
		exit 1
	fi
	if nft list table inet dnsfilter >/dev/null 2>&1;then
		echo "`eval $E` [DNSFilter is running, rebuild rules]"
		del_rule
	fi
	remove_dnsmasq_conf
	clean_dns_dir
	if [ -n "$url" ] && [ ! -s "$T/failed" ];then
		[ "$flash" = "0" ] && [ ! -s "$T/rules.conf" ] && B=1
		[ "$flash" = "1" ] && [ ! -s "$L/rules/rules.conf" ] && B=1
	fi
	if [ "$B" = "1" ];then
		echo "`eval $E` [Download Subscribe Rules...]"
		"$P/addown" --down "$B" >/dev/null 2>&1 &
		exit 9
	fi
	echo "`eval $E` [Load DNSFilter Rules]"
	add_dns
	if ! add_rule; then
		remove_dnsmasq_conf
		clean_dns_dir
		exit 1
	fi
	add_cron
	if [ "$STATUS" = "Y" ];then
		echo "`eval $E` [Dnsmasq Change]"
		/etc/init.d/dnsmasq restart >/dev/null 2>&1
	fi
}

stop(){
	enable=$(uci -q get dnsfilter.@dnsfilter[0].enable)
	flash=$(uci -q get dnsfilter.@dnsfilter[0].flash)
	url=$(uci -q get dnsfilter.@dnsfilter[0].url)
	# 先移除 dnsmasq 的 conf-dir 引用，防止 dnsmasq 找不到目录
	remove_dnsmasq_conf
	# 只清空规则目录，不删除目录本身，避免 dnsmasq 读取到旧引用时报目录不存在
	clean_dns_dir
	del_rule
	for pid in $(ps -w | grep "$P/dnsfilter" | grep -v grep | awk '{print$1}'); do
		kill -9 "$pid" 2>/dev/null
	done
	for pid in $(ps -w | grep "$P/addown" | grep -v grep | awk '{print$1}'); do
		kill -9 "$pid" 2>/dev/null
	done
	for pid in $(ps -w | grep "ad_new.conf" | grep -v grep | awk '{print$1}'); do
		kill -9 "$pid" 2>/dev/null
	done
	rm -f /var/lock/dnsfilter.lock
	echo "`eval $E` [Stop DNSFilter]"
	old_url="$(cat "$T/url" 2>/dev/null)"
	[ -n "$old_url" ] || old_url="$(cat "$L/rules/url" 2>/dev/null)"
	if [ "$(echo "$url" | sed 's/ /\n/g' | sort -u)" != "$old_url" ];then
		# 订阅 URL 变更时清理旧规则，确保下次 start 重新下载。
		rm -rf "$T"
		[ -d "$L/rules" ] && rm -rf "$L/rules"
	fi
	([ -h "$T/url" ] && [ "$flash" = "0" ] || [ -z "$url" ]) && rm -rf "$T"
	[ "$enable" = "0" ] && del_cron
	if [ "$STATUS" = "Y" ];then
		# STATUS=Y 时只清理非 flash 模式的临时目录，避免误删 flash 模式的链接
		if [ "$flash" != "1" ]; then
			rm -rf "$T"
		fi
		echo "`eval $E` [Revert Dnsmasq]"
		/etc/init.d/dnsmasq restart >/dev/null 2>&1
	fi
}

restart(){
	enable=$(uci -q get dnsfilter.@dnsfilter[0].enable)
	if [ "$enable" = "1" ];then
		STATUS=N
		stop
		start
		echo "`eval $E` [Restart Dnsmasq]"
		/etc/init.d/dnsmasq restart >/dev/null 2>&1
	else
		stop
	fi
}

reload(){
	restart
}

boot(){
	start
}
